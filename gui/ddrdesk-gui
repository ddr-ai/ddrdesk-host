#!/usr/bin/env python3
"""DDRDesk host control panel for KDE / Qt 6."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import Qt, QTimer
from PySide6.QtGui import QFont, QGuiApplication, QIcon
from PySide6.QtWidgets import (
    QApplication,
    QCheckBox,
    QGridLayout,
    QGroupBox,
    QHBoxLayout,
    QLabel,
    QMessageBox,
    QPushButton,
    QPlainTextEdit,
    QVBoxLayout,
    QWidget,
)

HOME = Path.home()
DATA = HOME / ".local/share/ddrdesk"
STATUS = DATA / "status.json"
ID_FILE = DATA / "connection-id"
CTL = "/usr/local/bin/ddrdesk-ctl"


def run(cmd: list[str], timeout: float = 8) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def ctl(*args: str) -> subprocess.CompletedProcess:
    if os.access(CTL, os.X_OK):
        return run(["sudo", "-n", CTL, *args])
    return run(["sudo", "-n", "systemctl", *args, "ddrdesk"])


class Window(QWidget):
    def __init__(self) -> None:
        super().__init__()
        self.setWindowTitle("DDRDesk")
        self.setMinimumSize(520, 640)
        self.setWindowIcon(QIcon.fromTheme("computer"))

        root = QVBoxLayout(self)
        root.setContentsMargins(16, 16, 16, 16)
        root.setSpacing(12)

        title = QLabel("DDRDesk host")
        title.setFont(QFont("", 18, QFont.Weight.DemiBold))
        root.addWidget(title)

        self.status_pill = QLabel("Checking…")
        self.status_pill.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.status_pill.setMinimumHeight(36)
        root.addWidget(self.status_pill)

        id_box = QGroupBox("Connection ID")
        id_l = QVBoxLayout(id_box)
        self.id_label = QLabel("— — —")
        self.id_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        f = QFont("monospace")
        f.setPointSize(28)
        f.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, 2)
        self.id_label.setFont(f)
        id_l.addWidget(self.id_label)
        hint = QLabel("Enter this 9-digit ID in the iPhone / iPad app.")
        hint.setAlignment(Qt.AlignmentFlag.AlignCenter)
        hint.setStyleSheet("color: palette(mid);")
        id_l.addWidget(hint)
        row = QHBoxLayout()
        self.btn_copy = QPushButton("Copy ID")
        self.btn_regen = QPushButton("New ID")
        row.addWidget(self.btn_copy)
        row.addWidget(self.btn_regen)
        id_l.addLayout(row)
        root.addWidget(id_box)

        svc = QGroupBox("Service")
        g = QGridLayout(svc)
        self.btn_start = QPushButton("Start")
        self.btn_stop = QPushButton("Stop")
        self.btn_restart = QPushButton("Restart")
        self.boot = QCheckBox("Start automatically at boot")
        g.addWidget(self.btn_start, 0, 0)
        g.addWidget(self.btn_stop, 0, 1)
        g.addWidget(self.btn_restart, 0, 2)
        g.addWidget(self.boot, 1, 0, 1, 3)
        root.addWidget(svc)

        net = QGroupBox("Network")
        nl = QVBoxLayout(net)
        self.clients = QLabel("Clients: —")
        self.endpoints = QLabel("Endpoints: —")
        self.endpoints.setWordWrap(True)
        self.endpoints.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        nl.addWidget(self.clients)
        nl.addWidget(self.endpoints)
        root.addWidget(net)

        ios = QGroupBox("iPhone / iPad app (no Mac, no Xcode)")
        il = QVBoxLayout(ios)
        self.ios_label = QLabel("Checking GitHub Actions IPA…")
        self.ios_label.setWordWrap(True)
        self.ios_label.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
        il.addWidget(self.ios_label)
        irow = QHBoxLayout()
        self.btn_ios_copy = QPushButton("Copy install page")
        self.btn_ios_open = QPushButton("Open install page")
        irow.addWidget(self.btn_ios_copy)
        irow.addWidget(self.btn_ios_open)
        il.addLayout(irow)
        root.addWidget(ios)

        logs = QGroupBox("Logs")
        ll = QVBoxLayout(logs)
        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setMaximumBlockCount(400)
        self.log.setFont(QFont("monospace", 9))
        ll.addWidget(self.log)
        root.addWidget(logs, 1)

        self.btn_copy.clicked.connect(self.copy_id)
        self.btn_regen.clicked.connect(self.regen_id)
        self.btn_start.clicked.connect(lambda: self.svc("start"))
        self.btn_stop.clicked.connect(lambda: self.svc("stop"))
        self.btn_restart.clicked.connect(lambda: self.svc("restart"))
        self.boot.toggled.connect(self.on_boot)
        self.btn_ios_copy.clicked.connect(self.copy_ios_page)
        self.btn_ios_open.clicked.connect(self.open_ios_page)
        self._ios = {}
        self._ios_tick = 0

        self._boot_guard = False
        self.timer = QTimer(self)
        self.timer.setInterval(1000)
        self.timer.timeout.connect(self.refresh)
        self.timer.start()
        self.refresh()

    def copy_id(self) -> None:
        raw = self.current_id()
        if raw:
            QGuiApplication.clipboard().setText(raw)
            self.status_pill.setText("ID copied")

    def current_id(self) -> str:
        if ID_FILE.exists():
            return ID_FILE.read_text().strip()
        data = self.status_json()
        return str(data.get("id", ""))

    def regen_id(self) -> None:
        if QMessageBox.question(
            self,
            "New connection ID",
            "Generate a new 9-digit ID? Existing phones must enter the new ID.",
        ) != QMessageBox.StandardButton.Yes:
            return
        r = run(["ddrdeskd", "--regen-id"])
        if r.returncode != 0:
            QMessageBox.warning(self, "DDRDesk", r.stderr or r.stdout or "regen failed")
            return
        self.svc("restart")

    def svc(self, action: str) -> None:
        r = ctl(action)
        if r.returncode != 0:
            QMessageBox.warning(
                self,
                "DDRDesk",
                (r.stderr or r.stdout or f"{action} failed")
                + "\n\nIf sudo asks for a password, run:\n  sudo visudo -f /etc/sudoers.d/ddrdesk",
            )
        self.refresh()

    def copy_ios_page(self) -> None:
        QGuiApplication.clipboard().setText("https://ddr-ai.github.io/ddrdesk-ios/")
        self.status_pill.setText("Install page copied — open it on the iPhone")

    def open_ios_page(self) -> None:
        run(["xdg-open", "https://ddr-ai.github.io/ddrdesk-ios/"])

    def fetch_ios(self) -> dict:
        try:
            import urllib.request
            req = urllib.request.Request(
                "https://github.com/ddr-ai/ddrdesk-ios/releases/download/unsigned-ipa/latest.json",
                headers={"User-Agent": "ddrdesk-gui"},
            )
            with urllib.request.urlopen(req, timeout=6) as r:
                return json.loads(r.read().decode())
        except Exception:
            return self._ios

    def on_boot(self, checked: bool) -> None:
        if self._boot_guard:
            return
        self.svc("enable" if checked else "disable")

    def status_json(self) -> dict:
        try:
            return json.loads(STATUS.read_text())
        except Exception:
            return {}

    def refresh(self) -> None:
        active = run(["systemctl", "is-active", "ddrdesk"]).stdout.strip()
        enabled = run(["systemctl", "is-enabled", "ddrdesk"]).stdout.strip()
        running = active == "active"
        data = self.status_json()
        pretty = data.get("id_pretty")
        if not pretty:
            ident = self.current_id()
            pretty = (
                f"{ident[0:3]} {ident[3:6]} {ident[6:9]}"
                if len(ident) == 9
                else (ident or "— — —")
            )
        self.id_label.setText(str(pretty))
        clients = data.get("clients", 0) if running else 0
        if running:
            self.status_pill.setText("Online — listening for the iPhone / iPad")
            self.status_pill.setStyleSheet(
                "background:#1b7f4e; color:white; border-radius:8px; padding:6px; font-weight:600;"
            )
        else:
            self.status_pill.setText("Offline — start the service to accept connections")
            self.status_pill.setStyleSheet(
                "background:#8a3030; color:white; border-radius:8px; padding:6px; font-weight:600;"
            )
        self.clients.setText(f"Connected clients: {clients}")
        eps = data.get("endpoints") or []
        self.endpoints.setText("Endpoints:\n" + ("\n".join(eps) if eps else "—"))
        self._boot_guard = True
        self.boot.setChecked(enabled in ("enabled", "enabled-runtime", "static"))
        self._boot_guard = False
        self.btn_start.setEnabled(not running)
        self.btn_stop.setEnabled(running)

        self._ios_tick += 1
        if self._ios_tick % 15 == 1:
            self._ios = self.fetch_ios()
        if self._ios:
            self.ios_label.setText(
                f"Latest IPA from GitHub Actions: {self._ios.get('version','?')} "
                f"(build {self._ios.get('build','?')})\n"
                "Open the install page on the iPhone (AltStore / SideStore / Feather / ESign). "
                "No Apple computer required.\n"
                "https://ddr-ai.github.io/ddrdesk-ios/"
            )
        logs = run(
            ["journalctl", "-u", "ddrdesk", "-n", "40", "--no-pager", "-o", "short-iso"],
            timeout=3,
        )
        if logs.stdout:
            self.log.setPlainText(logs.stdout)
            self.log.verticalScrollBar().setValue(self.log.verticalScrollBar().maximum())


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("DDRDesk")
    app.setDesktopFileName("ddrdesk")
    w = Window()
    w.show()
    return app.exec()


if __name__ == "__main__":
    raise SystemExit(main())
